# Caddy obtains and renews a Let's Encrypt certificate for $DOMAIN automatically.
# The DNS A record for $DOMAIN must point at this server, and ports 80 and 443 must be open.
{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server

		# HSTS. The max-age starts short (5 minutes) so a mistake clears quickly; raise HSTS_MAX_AGE in
		# .env to 31536000 (one year) once the site and every subdomain you use work over HTTPS.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:300}; includeSubDomains"

		# The CSP is enforced. If a page breaks, the console names what was blocked ("Refused to ...");
		# add that source here. To log without blocking again, rename the header to
		# Content-Security-Policy-Report-Only.
		# style-src needs 'unsafe-inline' for the inline style attributes React sets.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://server.arcgisonline.com; connect-src 'self' https://photon.komoot.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Browser features the dashboard never uses are switched off. Clipboard writes stay allowed (copy buttons).
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), display-capture=(), interest-cohort=()"
	}

	# The project landing page (site/): a short description of the app, documents, an author bio, and a
	# one-click guest demo. It is plain static files, so it needs no build step.
	redir /welcome /welcome/ 308
	handle_path /welcome/* {
		root * /srv/site
		file_server
	}

	# API requests go to FastAPI. Everything else is the dashboard.
	@api path /api/*
	handle @api {
		reverse_proxy server:8847
	}

	handle {
		reverse_proxy dashboard:3847
	}
}
